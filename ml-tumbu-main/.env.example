# Salin file ini menjadi .env lalu isi nilainya
# cp .env.example .env

# API Key untuk Google Gemini (analisis UTAMA)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter — fallback vision bila Gemini gagal / quota habis
# Dapatkan key: https://openrouter.ai/keys
# Priority: Gemini → OpenRouter → ML lokal (.pth) → color analysis
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Opsional: override model (default google/gemma-4-26b-a4b-it:free)
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Provider: auto | gemini | openrouter
# openrouter = skip Gemini, pakai OpenRouter saja (bagus untuk tes lokal)
VISION_PROVIDER=openrouter
# true = jangan muat ResNet9 (.pth)
DISABLE_LOCAL_ML=true
