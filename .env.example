# ─────────────────────────────────────────────
# Database (PostgreSQL via Docker)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://admin:password123@127.0.0.1:5434/tanilink

# ─────────────────────────────────────────────
# ML Disease Detection (ml-tumbu FastAPI server)
# Jalankan: cd ml-tumbu-main && uvicorn app:app --port 8000
# ─────────────────────────────────────────────
ML_API_URL=http://localhost:8000

# ─────────────────────────────────────────────
# Gemini API Key — dipakai untuk:
#   1. AI Q&A di dashboard publik (/api/qa)
#   2. ML disease detection di ml-tumbu (analisis UTAMA)
# Dapatkan gratis: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────
# OpenRouter — fallback vision bila Gemini quota habis
# Dapatkan key: https://openrouter.ai/keys
# Set juga di Railway (ML server) agar production memakai fallback ini
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Opsional: override model (default google/gemma-4-26b-a4b-it:free)
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
